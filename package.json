{
  "name": "alfred-app",
  "version": "0.1.0",
  "private": true,
  "description": "Alfred for iPhone and Android: a Capacitor shell around the live Alfred web page, with native background audio.",
  "type": "module",
  "scripts": {
    "build": "npm --prefix packages/alfred-audio run build",
    "sync": "npm run build && cap sync",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix packages/alfred-audio run typecheck",
    "test:ios": "sh scripts/swift-test.sh",
    "test:ios-direct": "sh scripts/swift-test-direct.sh",
    "test:android": "cd android && ./gradlew :alfred-audio:testDebugUnitTest",
    "test:android-direct": "sh scripts/kotlin-test-direct.sh",
    "build:ios-sim": "sh scripts/build-ios-sim.sh",
    "build:android": "cd android && ./gradlew assembleDebug",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "alfred-audio": "file:packages/alfred-audio"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "typescript": "^5.9.3"
  }
}
