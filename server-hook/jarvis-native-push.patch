--- orig/jarvis/apns.py	1970-01-01 05:30:00
+++ new/jarvis/apns.py	2026-09-27 16:47:17
@@ -0,0 +1,195 @@
+"""Native push through Apple's APNs: the same heartbeat alerts and task updates as Web Push (jarvis.push), for
+the JARVIS iPhone app (jarvis-app), whose web view can't do Web Push.
+
+When a voice session starts, the app asks iOS for its APNs device token and posts it to jarvis.web's
+/api/push/native with the passcode; it's kept in data/push_devices.json, one per device. send_push() in
+jarvis.push sends to these as well as to the Web Push subscriptions. Each push is an HTTP/2 request to
+api.push.apple.com (or api.sandbox.push.apple.com, for builds Xcode installed), authenticated with a JWT
+signed by the APNs auth key from the Apple Developer account: secrets/apns_key.p8, with its key id and the
+team id in .env (JARVIS_APNS_KEY_ID, JARVIS_APNS_TEAM_ID). APNs answering 410, or BadDeviceToken, means the
+app was removed or the token is stale, so the device is dropped.
+
+Needs httpx's HTTP/2 support: uv add 'httpx[http2]'.
+"""
+
+import asyncio
+import base64
+import functools
+import json
+import logging
+import re
+import time
+from pathlib import Path
+
+import httpx
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.asymmetric.utils import decode_dss_signature
+
+from .config import APNS_KEY_FILE, APNS_KEY_ID, APNS_TEAM_ID, PUSH_DEVICES_FILE
+from .files import write_atomic
+from .push import MAX_DEVICES, TTL, SEND_TIMEOUT, _locked
+
+log = logging.getLogger("jarvis.apns")
+HOSTS = {"production": "https://api.push.apple.com", "development": "https://api.sandbox.push.apple.com"}
+JWT_LIFETIME = 50 * 60  # APNs refuses tokens older than an hour, and ones renewed more than every 20 minutes
+MAX_PAYLOAD = 4096  # bytes, APNs's limit for an alert
+_TOKEN = re.compile(r"^[0-9a-f]{64,200}$")
+_TOPIC = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.-]{0,154}$")  # a bundle id
+GONE = {"BadDeviceToken", "Unregistered", "DeviceTokenNotForTopic"}
+NOT_SET_UP = ("APNs isn't set up on the Mac: put the APNs auth key in secrets/apns_key.p8 and set "
+              "JARVIS_APNS_KEY_ID and JARVIS_APNS_TEAM_ID in .env, then restart JARVIS.")
+
+
+def configured() -> bool:
+    return bool(APNS_KEY_ID and APNS_TEAM_ID) and APNS_KEY_FILE.is_file()
+
+
+# ── Devices ─────────────────────────────────────────────────────
+
+
+def validate(info: object) -> dict:
+    """What the app posts: its token (hex), which APNs server it's for, and its bundle id."""
+    if not isinstance(info, dict):
+        raise ValueError("device must be an object")
+    token = str(info.get("token", "")).lower()
+    if not _TOKEN.match(token):
+        raise ValueError("token is missing or malformed")
+    environment = info.get("environment")
+    if environment not in HOSTS:
+        raise ValueError("environment must be development or production")
+    topic = info.get("topic")
+    if not isinstance(topic, str) or not _TOPIC.match(topic):
+        raise ValueError("topic must be the app's bundle id")
+    return {"token": token, "environment": environment, "topic": topic}
+
+
+class Devices:
+    """The app installs to push to, in a JSON file shared by the web app and the task runner."""
+
+    def __init__(self, path: Path | None = None) -> None:
+        self.path = path or PUSH_DEVICES_FILE
+
+    def all(self) -> list[dict]:
+        try:
+            data = json.loads(self.path.read_text())
+        except FileNotFoundError:
+            return []
+        except ValueError:
+            log.warning("%s is unreadable; no app devices to push to", self.path.name)
+            return []
+        return [d for d in data if isinstance(d, dict) and "token" in d] if isinstance(data, list) else []
+
+    def add(self, info: object, device: str = "") -> dict:
+        """Store a device's token, replacing any earlier entry with the same token."""
+        dev = validate(info) | {"device": device[:40], "added": time.time()}
+        with _locked(self.path):
+            devices = [d for d in self.all() if d["token"] != dev["token"]]
+            write_atomic(self.path, json.dumps((devices + [dev])[-MAX_DEVICES:], indent=1), mode=0o600)
+        return dev
+
+    def remove(self, tokens: set[str]) -> int:
+        with _locked(self.path):
+            devices = self.all()
+            keep = [d for d in devices if d["token"] not in tokens]
+            if len(keep) != len(devices):
+                write_atomic(self.path, json.dumps(keep, indent=1), mode=0o600)
+        return len(devices) - len(keep)
+
+
+# ── Provider token ──────────────────────────────────────────────
+
+
+def _b64(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+@functools.cache
+def _signing_key(path: Path) -> ec.EllipticCurvePrivateKey:
+    return serialization.load_pem_private_key(path.read_bytes(), password=None)
+
+
+_jwt: tuple[float, str] | None = None
+
+
+def provider_token(now: float | None = None) -> str:
+    """The ES256 JWT APNs wants in the authorization header, reused for 50 minutes."""
+    global _jwt
+    now = time.time() if now is None else now
+    if _jwt and now - _jwt[0] < JWT_LIFETIME:
+        return _jwt[1]
+    header = _b64(json.dumps({"alg": "ES256", "kid": APNS_KEY_ID}).encode())
+    claims = _b64(json.dumps({"iss": APNS_TEAM_ID, "iat": int(now)}).encode())
+    der = _signing_key(APNS_KEY_FILE).sign(f"{header}.{claims}".encode(), ec.ECDSA(hashes.SHA256()))
+    r, s = decode_dss_signature(der)
+    token = f"{header}.{claims}.{_b64(r.to_bytes(32, 'big') + s.to_bytes(32, 'big'))}"
+    _jwt = (now, token)
+    return token
+
+
+# ── Sending ─────────────────────────────────────────────────────
+
+
+def payload(title: str, body: str, url: str, tag: str) -> bytes:
+    """The alert, and where tapping it opens JARVIS (the app reads `url`), within APNs's size limit."""
+    title, body = title[:120], body[:1000]
+    while True:
+        data = json.dumps({"aps": {"alert": {"title": title, "body": body}, "sound": "default",
+                                   "thread-id": tag or "jarvis"}, "url": url, "tag": tag}).encode()
+        if len(data) <= MAX_PAYLOAD or not body:
+            return data
+        body = body[:-100]
+
+
+def _client() -> httpx.AsyncClient:
+    return httpx.AsyncClient(http2=True, timeout=SEND_TIMEOUT)
+
+
+async def _send(client, dev: dict, data: bytes, jwt: str, tag: str) -> str:
+    """"ok" if APNs took it, "gone" if the device token is no longer good, else "failed"."""
+    headers = {"authorization": f"bearer {jwt}", "apns-topic": dev["topic"], "apns-push-type": "alert",
+               "apns-priority": "10", "apns-expiration": str(int(time.time()) + TTL)}
+    if tag:
+        headers["apns-collapse-id"] = tag[:64]  # a newer push about the same task replaces the older one
+    try:
+        r = await client.post(f"{HOSTS[dev['environment']]}/3/device/{dev['token']}", content=data, headers=headers)
+    except Exception as e:
+        detail = type(e).__name__
+    else:
+        if r.status_code == 200:
+            return "ok"
+        try:
+            said = r.json()
+        except ValueError:
+            said = None
+        reason = str(said.get("reason", ""))[:60] if isinstance(said, dict) else ""
+        if r.status_code == 410 or reason in GONE:
+            return "gone"
+        detail = f"HTTP {r.status_code} {reason}".strip()
+    # the device token stays out of the log
+    log.warning("APNs push to %s (%s) failed: %s", dev.get("device") or "a device", dev["environment"], detail)
+    return "failed"
+
+
+async def send(title: str, body: str, url: str = "/", tag: str = "", devices: Devices | None = None) -> int:
+    """Show a notification on every registered app. Returns how many APNs accepted."""
+    store = devices or Devices()
+    targets = store.all()
+    if not targets:
+        return 0
+    if not configured():
+        log.warning("%d app device%s registered, but %s", len(targets), "" if len(targets) == 1 else "s", NOT_SET_UP)
+        return 0
+    try:
+        jwt = await asyncio.to_thread(provider_token)
+        client = _client()
+    except Exception as e:  # an unreadable key, or httpx without h2
+        log.warning("APNs push not sent: %s: %s", type(e).__name__, e if isinstance(e, ImportError) else "")
+        return 0
+    async with client:
+        data = payload(title, body, url, tag)
+        results = await asyncio.gather(*(_send(client, d, data, jwt, tag) for d in targets))
+    if gone := {d["token"] for d, r in zip(targets, results) if r == "gone"}:
+        store.remove(gone)
+        log.info("dropped %d app device%s APNs no longer knows", len(gone), "" if len(gone) == 1 else "s")
+    return results.count("ok")
