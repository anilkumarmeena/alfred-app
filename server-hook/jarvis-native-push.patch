+class Request:
+    remote = "100.64.0.2"
+
+    def __init__(self, body: dict) -> None:
+        self.body = body
+
+    async def json(self) -> dict:
+        return self.body
+
+
+def reply(body: dict) -> tuple[int, dict]:
+    r = asyncio.run(web.push_native(Request(body)))
+    return r.status, json.loads(r.text)
