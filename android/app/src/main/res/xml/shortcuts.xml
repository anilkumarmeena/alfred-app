<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Change server" opens the first-run page. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_server"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_change_server"
        android:shortcutLongLabel="@string/shortcut_change_server">
        <intent
            android:action="com.anil.jarvis.SETUP"
            android:targetPackage="com.anil.jarvis"
            android:targetClass="com.anil.jarvis.MainActivity" />
    </shortcut>
</shortcuts>
