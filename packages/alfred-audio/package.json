{
  "name": "alfred-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor plugin: Alfred's voice session run natively, so the mic keeps going in the background and the earphone button mutes it.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "ios/Sources/",
    "android/src/main/",
    "android/build.gradle",
    "Package.swift"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^7.6.9",
    "typescript": "^5.9.3"
  }
}
